# Credenciais da API Omie (App Key / App Secret)
# Gere em: Omie > Configuracoes > Aplicativos > Chaves de Aplicativo
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Opcional: limite de requisicoes por segundo enviadas para a API da Omie
# (protege contra erro de rate limit em bases com muitos titulos/clientes)
OMIE_MAX_REQ_POR_SEGUNDO=3
