# Credenciais da API Omie (App Key / App Secret)
# Gere em: Omie > Configuracoes > Aplicativos > Chaves de Aplicativo
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Opcional: limite de requisicoes por segundo enviadas para a API da Omie
# (protege contra erro de rate limit em bases com muitos titulos/clientes)
OMIE_MAX_REQ_POR_SEGUNDO=3

# Obrigatorio so para main_caixa.py: contas correntes consideradas no saldo
# de caixa, exatamente como aparecem no cadastro da Omie (geral/contacorrente
# > ListarContasCorrentes). Formato: "nome no cadastro:rotulo de exibicao",
# separados por virgula — o rotulo e opcional (sem ":", usa o proprio nome
# do cadastro). Exemplo (substitua pelos nomes reais das suas contas):
# OMIE_CONTAS_CAIXA=Banco Principal:Conta Corrente,Banco Principal - CONTA APLICACAO:Conta Aplicacao
OMIE_CONTAS_CAIXA=
